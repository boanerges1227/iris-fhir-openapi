Class FHIR.OpenAPI.Mapping.Interactions Extends %RegisteredObject
{
/// Merge a single unambiguous path/method pair; conflicts must not be silently overwritten by later writes.
ClassMethod Add(spec, path As %String, method As %String, code As %String, resource As %String, flags, params, options, report, conditional As %Boolean = 0)
{
    If code'="metadata",options.interactions.%IsDefined("include"),'##class(FHIR.OpenAPI.Options).Contains(options.interactions.include,code) Quit
    If 'spec.paths.%IsDefined(path) Do spec.paths.%Set(path,{})
    Set item=spec.paths.%Get(path)
    If item.%IsDefined(method) Do ##class(FHIR.OpenAPI.Report).Add(report,"PATH_METHOD_CONFLICT","error","Duplicate path-method pair cannot be safely merged.",path,resource,code) Quit
    Set op={"operationId":(resource_"_"_$Translate(code,"-","_")_"_"_method_$Select(conditional:"_conditional",1:"")),"summary":(code_" "_resource),"tags":[(resource)],"parameters":[],"responses":(##class(FHIR.OpenAPI.Mapping.Responses).Build(code,resource,flags,conditional))}
    For name="id","vid" {
        If path[("{"_name_"}") Do op.parameters.%Push({"name":(name),"in":"path","required":true,"schema":{"type":"string","pattern":"^[A-Za-z0-9.-]{1,64}$"}})
    }
    If (code="search-type")!(code="search-system")!conditional {
        If method="post",'conditional {
            Set op.requestBody=##class(FHIR.OpenAPI.Mapping.Search).Body(params)
        } Else {
            Set ps=##class(FHIR.OpenAPI.Mapping.Search).Parameters(params)
            For i=0:1:ps.%Size()-1 Do op.parameters.%Push(ps.%Get(i))
        }
    }
    If conditional Set op.description="Must supply a valid search condition matching the target; this simplified spec cannot enforce at least one dynamic query condition."
    If (code="create")!(code="update")!(code="patch")!(code="batch")!(code="transaction") {
        Do op.parameters.%Push(..Header("Prefer","return=representation, return=minimal, or return=OperationOutcome.",0))
        Set schema=$Select((code="batch")!(code="transaction"):"BundleRequest",1:resource)
        Set op.requestBody={"required":true,"content":{"application/fhir+json":{"schema":(##class(FHIR.OpenAPI.Schema.Gateway).Ref(schema))}}}
        If (code="update")!(code="patch") Do op.parameters.%Push(..Header("If-Match","Resource version ETag; enables optimistic concurrency control.",(flags.%Get("versioning")="versioned-update")))
        If code="create",flags.%Get("conditionalCreate") Do op.parameters.%Push(..Header("If-None-Exist","FHIR search condition; only creates when no matching resource exists.",0))
        If code="patch" {
            Set content={},formats=flags.patchFormats
            For i=0:1:formats.%Size()-1 {
                Set fmt=formats.%Get(i)
                If (fmt'="application/json-patch+json")&(fmt'="application/fhir+json") Continue
                Do content.%Set(fmt,{"schema":(##class(FHIR.OpenAPI.Schema.Gateway).Ref($Select(fmt="application/json-patch+json":"JSONPatch",1:"Parameters")))})
            }
            Set op.requestBody.content=content
        }
    }
    If code="read" {
        Set read=flags.%Get("conditionalRead","not-supported")
        If (read="modified-since")!(read="full-support") Do op.parameters.%Push(..Header("If-Modified-Since","HTTP date; returns 304 when resource is unchanged.",0))
        If (read="not-match")!(read="full-support") Do op.parameters.%Push(..Header("If-None-Match","Resource version ETag; returns 304 when unchanged.",0))
    }
    If options.security.mode'="none",options.security.mode'="unspecified" {
        For status="401","403" Do op.responses.%Set(status,{"description":"Public API authentication or authorization failure; body may be generated by the gateway."})
    }
    If (code="read")!(code="vread")!(code="create")!(code="update")!(code="patch") {
        Set it=op.responses.%GetIterator()
        While it.%GetNext(.status,.response) {
            If $Extract(status)'="2" Continue
            Set response.headers={"ETag":{"schema":{"type":"string"},"description":"Resource version."},"Last-Modified":{"schema":{"type":"string"},"description":"Last modified time."}}
            If (status="201") Set response.headers.Location={"schema":{"type":"string"},"description":"Created resource location."}
        }
    }
    Do item.%Set(method,op)
}
/// Build an HTTP header parameter; the required flag stays a JSON boolean.
ClassMethod Header(name, description, required As %Boolean) As %DynamicObject
{
    Set h={"name":(name),"in":"header","description":(description),"schema":{"type":"string"}}
    Do h.%Set("required",required,"boolean")
    Quit h
}
}
